  classDef H3  fill:#82cfe9,stroke:#333
  classDef H4  fill:#96d8f0,stroke:#333
  classDef H5  fill:#a9e1f6,stroke:#333

  classDef H6  fill:#bbf,stroke:#333
  classDef H7  fill:#c8c8ff,stroke:#333
  classDef H8  fill:#d5d5ff,stroke:#333
  classDef H9  fill:#e2e2ff,stroke:#333
  classDef H10 fill:#eeeeff,stroke:#333

  classDef H11 fill:#bfb,stroke:#333
  classDef H12 fill:#c9f5c9,stroke:#333
  classDef H13 fill:#d4f8d4,stroke:#333
  classDef H14 fill:#defade,stroke:#333
  classDef H15 fill:#e9fce9,stroke:#333

  classDef H16 fill:#ebe,stroke:#333
  classDef H17 fill:#f2c9f2,stroke:#333
  classDef H18 fill:#f7d6f7,stroke:#333
  classDef H19 fill:#fbe3fb,stroke:#333
  classDef H20 fill:#fdf0fd,stroke:#333

  linkStyle 0,1,4  stroke:#5abddb,stroke-width:3px;
  linkStyle 13,14  stroke:#ff5555,stroke-width:3px;
  classDef L3  stroke:#4CAF50,stroke-width:3px;
  classDef L4  stroke:#FFB020,stroke-width:3px;
  classDef L5  stroke:#3B82F6,stroke-width:3px;
  classDef L6  stroke:#8B5CF6,stroke-width:3px;
  classDef L7  stroke:#EC4899,stroke-width:3px;
  classDef L8  stroke:#14B8A6,stroke-width:3px;
  linkStyle 15,16  stroke:#F97316,stroke-width:3px;
  classDef L10 stroke:#6B7280,stroke-width:3px;

  class A H1
  class J H11
  class F H11
  class C H6
  class Z H1
